# --- Database (SQLite - a single local file, zero server setup) ---
DATABASE_URL=sqlite:///./data/scai.db
# --- Cache / Queue (optional - only needed for the background worker) ---
REDIS_URL=redis://localhost:6379/0
# --- Auth ---
JWT_SECRET=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# --- External data sources ---
EVENT_REGISTRY_API_KEY=
# --- LLM ---
# LLM_PROVIDER: gemini | openrouter | anthropic
LLM_PROVIDER=gemini
# LLM_MODEL: leave blank to use each provider's sensible default
#   gemini default:     gemini-2.0-flash
#   openrouter default: openai/gpt-4o-mini  (any OpenRouter model slug works)
#   anthropic default:  must be set explicitly, e.g. claude-sonnet-4-6
LLM_MODEL=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=
# --- Embeddings (local = dependency-free hashing embedder, works offline) ---
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
# --- Alerts ---
SLACK_WEBHOOK_URL=
EMAIL_API_KEY=
EMAIL_FROM=alerts@supplychain-ai.example.com
# --- Storage ---
STORAGE_BUCKET=./storage
# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
